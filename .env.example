# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mmk?schema=public"

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Public site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# First admin (used only by prisma/seed.ts)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Email — leave blank in dev; the app shows an admin setup banner instead of faking sends
RESEND_API_KEY=""
EMAIL_FROM="MMK <hello@yourdomain.com>"

# Storage — "local" for dev, "s3" for production
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""